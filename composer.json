{
    "name": "imran/laravel-dynamic-config",
    "version": "0.0.1",
    "description": "Dynamic runtime configuration system for Laravel applications.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "symfony/yaml": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Imran",
            "email": "silent.lips125@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Imran\\DynamicConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Imran\\DynamicConfig\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Imran\\DynamicConfig\\DynamicConfigServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}